# Copy this file to .env and fill in real values. NEVER commit the real .env.

# --- App ---
APP_NAME="Exit Interview Platform API"
APP_ENV=development
DEBUG=true

# --- Database (Neon PostgreSQL) ---
# Use the "pooled" connection string from your Neon project settings.
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.neon.tech/exit_interview?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# --- Clerk Authentication ---
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_AUDIENCE=
# Optional fallback instead of CLERK_JWKS_URL (static PEM public key):
CLERK_JWT_KEY=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Existing AI Interview Bot (separate FastAPI service) ---
AI_INTERVIEW_SERVICE_URL=https://ai-interview.internal.example.com
AI_INTERVIEW_SERVICE_API_KEY=
AI_INTERVIEW_SERVICE_TIMEOUT_SECONDS=15
AI_INTERNAL_WEBHOOK_SECRET=

# --- Email ---
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME="Exit Interview Platform"
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
ADDITIONAL_CORS_ORIGINS=

# --- Uploads ---
MAX_IMPORT_FILE_SIZE_MB=10
ALLOWED_IMPORT_EXTENSIONS=.xlsx,.xls,.csv,.pdf

# --- Invitations ---
INVITATION_TOKEN_EXPIRY_DAYS=14
EMPLOYEE_ACCESS_URL_PATH=/employee/access

# --- Security ---
SECRET_KEY=change-me-in-production
